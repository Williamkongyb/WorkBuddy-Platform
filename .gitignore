# ===================== WorkBuddy 短视频智能中台 v4.0 =====================
# Git 忽略规则

# ---- Python ----
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
*.egg
*.spec
*.manifest
*.exe
venv/
env/
.venv/
ENV/
env.bak/
venv.bak/
pip-log.txt
pip-delete-this-directory.txt

# ---- Node ----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
package-lock.json
.npm
.eslintcache
*.tsbuildinfo
.next/
.nuxt/
.cache/
.parcel-cache/

# ---- 环境变量（含 API Key，严禁提交）----
.env
.env.local
.env.*.local
*.key
*.pem
secrets/
credentials.json

# ---- 生成资产（临时/输出文件）----
final_videos/
generated_images/
audio_segments/
temp_seedance/
temp/
tmp/
*.mp4
*.avi
*.mov
*.mkv
*.webm

# ---- 日志 & 缓存 ----
logs/
*.log
*.db
*.db-journal
*.db-wal
*.db-shm
video_data.db
browser_data/
.cache/

# ---- 媒体文件 ----
bgm/*.mp3
bgm/*.wav
bgm/*.ogg
*.wav
*.mp3
# 保留 bgm 目录结构
!bgm/.gitkeep

# ---- IDE & 编辑器 ----
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-project
*.sublime-workspace

# ---- 系统文件 ----
$RECYCLE.BIN/
System Volume Information/
Desktop.ini

# ---- 文档临时文件 ----
~$*.docx
~$*.xlsx
~$*.pptx
~$*.pdf
*.tmp

# ---- 自动化 ----
automation/
memory/

# ---- 论文 & 分析临时输出 ----
paper*_full.txt
paper*_text.txt

# ---- WorkBuddy 内部 ----
.workbuddy/

# ---- 自定义 ----
# 保留以下目录结构
!final_videos/.gitkeep
!logs/.gitkeep
!generated_images/.gitkeep
!audio_segments/.gitkeep
!temp_seedance/.gitkeep
!browser_data/.gitkeep
!bgm/.gitkeep
